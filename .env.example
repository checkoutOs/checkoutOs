# ─────────────────────────────────────────────────────────────────────────────
# checkoutOs — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ── Runtime ───────────────────────────────────────────────────────────────────

# Application environment
# Options: development | production | test
NODE_ENV=development

# HTTP server port
# Default: 3000
PORT=3000


# ── Gateway ───────────────────────────────────────────────────────────────────

# Which payment gateway to use
# Options: razorpay | payu | cashfree
# Only the credentials for the active gateway are required
ACTIVE_GATEWAY=razorpay


# ── Redis ─────────────────────────────────────────────────────────────────────

# Redis connection string
# Must start with redis:// (plain) or rediss:// (TLS)
# Docker local:      redis://localhost:6379
# Docker Compose:    redis://redis:6379  (uses service name)
# Redis Cloud:       rediss://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379


# ── Webhook Relay ─────────────────────────────────────────────────────────────

# URL where checkoutOs forwards normalized webhook events
# checkoutOs receives the raw gateway webhook, normalizes it,
# and relays it here so your application receives consistent events
# regardless of which gateway is active.
#
# Must be a publicly accessible URL in production.
# For local testing: use https://webhook.site to inspect events
WEBHOOK_RELAY_URL=https://webhook.site/your-unique-id


# ── Razorpay Credentials ──────────────────────────────────────────────────────
# Required when ACTIVE_GATEWAY=razorpay

# API key ID from your Razorpay dashboard
# Test keys start with rzp_test_
# Live keys start with rzp_live_
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# API key secret from your Razorpay dashboard
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook secret — set in your Razorpay dashboard under Webhooks
# Used to verify that incoming webhooks are genuinely from Razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Optional: Override the Razorpay API base URL
# Leave commented out to use the real Razorpay API (production)
# Set to http://localhost:9090 to use the local mock server (development/CI)
# RAZORPAY_BASE_URL=http://localhost:9090


# ── PayU Credentials ─────────────────────────────────────────────────────────
# Required when ACTIVE_GATEWAY=payu
# (PayU plugin is pending — V1.x)

# PAYU_MERCHANT_KEY=your_payu_merchant_key
# PAYU_MERCHANT_SALT=your_payu_merchant_salt
# PAYU_WEBHOOK_SECRET=your_payu_webhook_secret

# Optional: Override PayU API base URL for mock server
# PAYU_BASE_URL=http://localhost:9091


# ── Cashfree Credentials ──────────────────────────────────────────────────────
# Required when ACTIVE_GATEWAY=cashfree
# (Cashfree plugin is pending — V1.x)

# CASHFREE_APP_ID=your_cashfree_app_id
# CASHFREE_SECRET_KEY=your_cashfree_secret_key
# CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# Optional: Override Cashfree API base URL for mock server
# CASHFREE_BASE_URL=http://localhost:9092


# ── Mock Server ───────────────────────────────────────────────────────────────
# Only relevant when running the local mock gateway server

# Port for the mock gateway server
# Default: 9090
# MOCK_PORT=9090


# ─────────────────────────────────────────────────────────────────────────────
# Example: Local development with mock server
# ─────────────────────────────────────────────────────────────────────────────
#
# NODE_ENV=development
# PORT=3000
# ACTIVE_GATEWAY=razorpay
# REDIS_URL=redis://localhost:6379
# WEBHOOK_RELAY_URL=http://localhost:4000/webhook
# RAZORPAY_BASE_URL=http://localhost:9090
# RAZORPAY_KEY_ID=rzp_test_mockKeyId00001
# RAZORPAY_KEY_SECRET=mockSecret00001
# RAZORPAY_WEBHOOK_SECRET=mockWebhookSecret001
#
# ─────────────────────────────────────────────────────────────────────────────
# Example: Production with real Razorpay
# ─────────────────────────────────────────────────────────────────────────────
#
# NODE_ENV=production
# PORT=3000
# ACTIVE_GATEWAY=razorpay
# REDIS_URL=rediss://:your_password@your-redis-host:6380
# WEBHOOK_RELAY_URL=https://api.yourapp.com/webhooks/checkoutos
# RAZORPAY_KEY_ID=rzp_live_your_live_key_id
# RAZORPAY_KEY_SECRET=your_live_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret


PAYTM_MERCHANT_ID=your_merchant_id_here
PAYTM_MERCHANT_KEY=your_merchant_key_here
PAYTM_WEBHOOK_SECRET=your_webhook_secret_here

