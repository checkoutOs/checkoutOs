      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (gateway) (rate(checkoutos_gateway_requests_total{gateway=~\"$gateway\", operation=\"createPayment\", outcome!=\"success\"}[$__rate_interval]))) / (sum by (gateway) (rate(checkoutos_gateway_requests_total{gateway=~\"$gateway\", operation=\"createPayment\"}[$__rate_interval])))",
          "legendFormat": "{{gateway}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          }
        },
        "overrides": []
