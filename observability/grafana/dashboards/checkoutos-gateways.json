{
  "uid": "checkoutos-gateways",
  "title": "checkoutOs — Gateways",
  "description": "Per-gateway latency and errors — the failover view.",
  "tags": [
    "checkoutos",
    "gateways"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "checkoutos"
      ],
      "asDropdown": true,
      "title": "checkoutOs",
      "includeVars": true,
      "keepTime": true
    },
    {
      "type": "link",
      "title": "Metric reference (docs/metrics.md)",
      "url": "https://github.com/checkoutOs/checkoutOs/blob/main/docs/metrics.md",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "gateway",
        "label": "Gateway",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(checkoutos_gateway_requests_total, gateway)",
          "refId": "gateway"
        },
        "definition": "label_values(checkoutos_gateway_requests_total, gateway)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Payment creation",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "createPayment failure ratio",
      "description": "Alert at 2% for 5m: PaymentCreationFailureRate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(checkoutos_gateway_requests_total{gateway=~\"$gateway\", operation=\"createPayment\", outcome!=\"success\"}[$__rate_interval]))) / (sum(rate(checkoutos_gateway_requests_total{gateway=~\"$gateway\", operation=\"createPayment\"}[$__rate_interval])))",
          "legendFormat": "createPayment failure ratio",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          },
          "color": {
            "mode": "thresholds",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "createPayment p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(checkoutos_gateway_request_duration_bucket{gateway=~\"$gateway\", operation=\"createPayment\"}[$__rate_interval])))",
          "legendFormat": "createPayment p99",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          },
          "color": {
            "mode": "thresholds",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Timeouts (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(checkoutos_gateway_requests_total{gateway=~\"$gateway\", outcome=\"timeout\"}[$__range]))",
          "legendFormat": "Timeouts (range)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "createPayment failure ratio by gateway",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
