{
  "uid": "checkoutos-webhooks",
  "title": "checkoutOs — Webhooks",
  "description": "Inbound delivery, signature failures, state machine, and relay health.",
  "tags": [
    "checkoutos",
    "webhooks"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "checkoutos"
      ],
      "asDropdown": true,
      "title": "checkoutOs",
      "includeVars": true,
      "keepTime": true
    },
    {
      "type": "link",
      "title": "Metric reference (docs/metrics.md)",
      "url": "https://github.com/checkoutOs/checkoutOs/blob/main/docs/metrics.md",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "gateway",
        "label": "Gateway",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(checkoutos_gateway_requests_total, gateway)",
          "refId": "gateway"
        },
        "definition": "label_values(checkoutos_gateway_requests_total, gateway)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Inbound",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Signature failures (range)",
      "description": "Any sustained rate: wrong webhook secret or forgery. Alert: GatewaySignatureFailures.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(checkoutos_webhook_signature_failures_total{gateway=~\"$gateway\"}[$__range]))",
          "legendFormat": "Signature failures (range)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
